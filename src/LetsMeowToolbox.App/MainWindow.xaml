<Window x:Class="LetsMeowToolbox.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:hc="https://handyorg.github.io/handycontrol"
        Title="Let's Meow Toolbox"
        Icon="Assets/app.ico"
        Width="1120" Height="760"
        MinWidth="960" MinHeight="640"
        WindowStartupLocation="CenterScreen"
        FontFamily="Segoe UI Variable Text, Microsoft YaHei UI, Segoe UI"
        FontSize="14"
        Foreground="{DynamicResource TextPrimary}"
        Background="{DynamicResource AppBackground}">

    <Grid x:Name="RootGrid">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="236"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- ===== 侧边栏 ===== -->
        <Border Grid.Column="0" Background="{DynamicResource RegionBrush}"
                BorderBrush="{DynamicResource BorderLine}" BorderThickness="0,0,1,0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- 左上角 Logo（横幅，透明底） -->
                <StackPanel Grid.Row="0" Margin="22,24,22,16">
                    <Image Source="Assets/logo_banner.png" Width="190"
                           HorizontalAlignment="Left" Stretch="Uniform"/>
                    <TextBlock Text="Windows 10 / 11 系统调优工具箱" FontSize="11"
                               Margin="2,4,0,0" Foreground="{DynamicResource TextSecondary}"/>
                </StackPanel>

                <StackPanel Grid.Row="1" x:Name="NavPanel" Margin="0,2,0,0"/>

                <StackPanel Grid.Row="2" Margin="20,10">
                    <TextBlock x:Name="TxtAdminStatus" FontSize="12" TextWrapping="Wrap"
                               Foreground="{DynamicResource TextSecondary}"/>
                    <Button x:Name="BtnElevate" Content="以管理员身份重新运行" Click="OnElevate"
                            Style="{DynamicResource FluentButtonSecondary}"
                            Margin="0,8,0,0" Visibility="Collapsed"/>
                    <TextBlock x:Name="TxtOs" FontSize="11" Margin="0,8,0,0"
                               Foreground="{DynamicResource TextDisabled}"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ===== 内容区 ===== -->
        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <Border Grid.Row="0" Padding="18,12" Background="{DynamicResource HeaderBrush}"
                    BorderBrush="{DynamicResource DividerBrush}" BorderThickness="0,0,0,1">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock x:Name="TxtTitle" Text="新手区" FontSize="18" FontWeight="SemiBold"
                               VerticalAlignment="Center"/>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="二次元装饰" FontSize="12" Foreground="{DynamicResource TextSecondary}"
                                   VerticalAlignment="Center"/>
                        <ToggleButton x:Name="TglAnime" Margin="8,0,0,0"
                                      VerticalAlignment="Center"
                                      Style="{DynamicResource FluentToggle}"
                                      IsChecked="{Binding ShowAnime, Mode=TwoWay}"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- 二次元温柔提示条（可一键关闭） -->
            <Border Grid.Row="1" Padding="18,8" Background="{DynamicResource AccentSoft}"
                    Visibility="{Binding ShowAnime, Converter={StaticResource BoolToVisibilityConverter}}">
                <TextBlock x:Name="TxtGreeting" FontSize="12.5"
                           Foreground="{DynamicResource TextSecondary}"
                           TextWrapping="Wrap"/>
            </Border>

            <ContentControl x:Name="MainContent" Grid.Row="2" Margin="18,14,18,18"/>

            <!-- 粉色顶部加载进度条（页面渲染时播放） -->
            <Grid Grid.Row="2" VerticalAlignment="Top" HorizontalAlignment="Stretch"
                  Height="3" IsHitTestVisible="False" x:Name="LoadBarContainer" Opacity="0">
                <Border x:Name="LoadBar" Height="3" HorizontalAlignment="Left" CornerRadius="2"
                        Width="{Binding ActualWidth, ElementName=LoadBarContainer}"
                        RenderTransformOrigin="0,0.5">
                    <Border.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                            <GradientStop Color="#00E8519C" Offset="0"/>
                            <GradientStop Color="#FFE8519C" Offset="0.5"/>
                            <GradientStop Color="#FFFFB3D6" Offset="1"/>
                        </LinearGradientBrush>
                    </Border.Background>
                    <Border.RenderTransform>
                        <ScaleTransform x:Name="LoadBarScale" ScaleX="0" ScaleY="1"/>
                    </Border.RenderTransform>
                </Border>
            </Grid>

            <!-- 顶部提示条挂载层（不拦截点击） -->
            <Grid Grid.RowSpan="3" IsHitTestVisible="False" VerticalAlignment="Top"
                  HorizontalAlignment="Stretch" Margin="0,10,0,0">
                <StackPanel x:Name="ToastHost" VerticalAlignment="Top"/>
            </Grid>
        </Grid>

        <!-- ===== iPadOS 风格光标层（不拦截点击） ===== -->
        <Grid Grid.ColumnSpan="2" IsHitTestVisible="False" x:Name="CursorLayer">
            <Border x:Name="CursorHalo" Width="10" Height="10" CornerRadius="10"
                    HorizontalAlignment="Left" VerticalAlignment="Top"
                    Background="#22E8519C" BorderBrush="#E8519C" BorderThickness="2"
                    Opacity="0" IsHitTestVisible="False">
                <Border.RenderTransform>
                    <TranslateTransform x:Name="HaloTranslate"/>
                </Border.RenderTransform>
            </Border>
            <Border x:Name="CursorDot" Width="9" Height="9" CornerRadius="4.5"
                    HorizontalAlignment="Left" VerticalAlignment="Top"
                    Background="#E8519C" BorderBrush="#FFFFFF" BorderThickness="1.5"
                    Opacity="0" IsHitTestVisible="False" SnapsToDevicePixels="False">
                <Border.RenderTransform>
                    <TranslateTransform x:Name="DotTranslate"/>
                </Border.RenderTransform>
            </Border>
        </Grid>
    </Grid>
</Window>
