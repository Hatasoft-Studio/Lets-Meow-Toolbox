<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:hc="https://handyorg.github.io/handycontrol"
                    xmlns:models="clr-namespace:LetsMeowToolbox.App.Models"
                    xmlns:views="clr-namespace:LetsMeowToolbox.App.Views">

    <!-- 共享转换器 -->
    <BooleanToVisibilityConverter x:Key="BoolToVisibilityConverter"/>
    <views:CoreBadgeConverter x:Key="CoreBadgeConverter"/>
    <views:AppliedConverter x:Key="AppliedConverter"/>

    <!-- 功能卡片模板：标题 + 风险徽标 + 人话说明 + 开关 + 底层路径(可选) -->
    <DataTemplate x:Key="FeatureCardTemplate" DataType="{x:Type models:FeatureViewModel}">
        <hc:Card Style="{DynamicResource FluentCard}" Margin="0,0,0,12" Padding="14,12">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- 标题 + 风险徽标 -->
                <StackPanel Orientation="Horizontal" Grid.Row="0" Grid.Column="0" VerticalAlignment="Center">
                    <Border Background="#22FF6E7D" CornerRadius="6" Padding="6,2" VerticalAlignment="Center">
                        <TextBlock Text="{Binding Risk}" FontSize="13"/>
                    </Border>
                    <TextBlock Text="{Binding Title}" FontWeight="SemiBold" FontSize="15"
                               Margin="10,0,0,0" VerticalAlignment="Center"/>
                </StackPanel>

                <ToggleButton Style="{DynamicResource FluentToggle}" Grid.Row="0" Grid.Column="1" Width="64" Height="30"
                              IsChecked="{Binding IsOn, Mode=TwoWay}"
                              VerticalAlignment="Center"/>

                <!-- 人话说明 -->
                <TextBlock Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2"
                           Text="{Binding Description}"
                           TextWrapping="Wrap" FontSize="12.5"
                           Foreground="{DynamicResource TextSecondary}"
                           Margin="0,8,0,0" LineHeight="18"/>

                <!-- 底层注册表/API 路径（可选，默认隐藏） -->
                <TextBlock Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="2"
                           Text="{Binding RegistryNote}"
                           TextWrapping="Wrap" FontSize="10.5"
                           Foreground="{DynamicResource TextDisabled}"
                           Margin="0,6,0,0"
                           Visibility="{Binding ShowRegistryNote, Converter={StaticResource BoolToVisibilityConverter}, RelativeSource={RelativeSource AncestorType=UserControl}}"/>
            </Grid>
        </hc:Card>
    </DataTemplate>

</ResourceDictionary>
