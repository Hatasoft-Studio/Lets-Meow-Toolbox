<Window x:Class="LetsMeowToolbox.App.Views.FluentDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Let's Meow Toolbox"
        WindowStyle="None" ResizeMode="NoResize"
        SizeToContent="WidthAndHeight" ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner"
        FontFamily="Segoe UI Variable Text, Microsoft YaHei UI, Segoe UI" FontSize="14"
        Background="{DynamicResource SurfaceBrush}"
        Foreground="{DynamicResource TextPrimary}"
        UseLayoutRounding="True">
    <Border Margin="12" CornerRadius="8" Background="{DynamicResource SurfaceBrush}"
            BorderBrush="{DynamicResource BorderLine}" BorderThickness="1">
        <Border.Effect>
            <DropShadowEffect BlurRadius="24" ShadowDepth="3" Opacity="0.22"
                              Color="#000000"/>
        </Border.Effect>
        <Grid Width="392" Margin="24,20,24,22">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <Grid Grid.Row="0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="TxtIcon" FontSize="24" Margin="0,0,10,0" VerticalAlignment="Top"
                           FontFamily="Segoe UI Emoji, Segoe UI"/>
                <TextBlock x:Name="TxtTitle" Grid.Column="1" FontSize="16" FontWeight="SemiBold"
                           TextWrapping="Wrap" VerticalAlignment="Center"/>
            </Grid>

            <TextBlock x:Name="TxtMessage" Grid.Row="1" FontSize="13" TextWrapping="Wrap"
                       Foreground="{DynamicResource TextSecondary}" Margin="0,14,0,0" LineHeight="20"/>

            <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,22,0,0">
                <Button x:Name="BtnCancel" Content="取消" Click="OnCancel"
                        Style="{DynamicResource FluentButtonSecondary}"
                        Visibility="Collapsed" MinWidth="92"/>
                <Button x:Name="BtnNo" Content="否" Click="OnNo"
                        Style="{DynamicResource FluentButtonSecondary}"
                        Visibility="Collapsed" MinWidth="92"/>
                <Button x:Name="BtnOk" Content="确定" Click="OnOk"
                        Style="{DynamicResource FluentButtonPink}"
                        Background="#E8519C" Foreground="#FFFFFF"
                        Visibility="Collapsed" MinWidth="92" Margin="10,0,0,0"/>
            </StackPanel>
        </Grid>
    </Border>
</Window>
