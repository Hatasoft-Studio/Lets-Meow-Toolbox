<UserControl x:Class="LetsMeowToolbox.App.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:hc="https://handyorg.github.io/handycontrol">
    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="4">
        <StackPanel>

            <StackPanel>
                <TextBlock Text="设置" FontSize="16" FontWeight="SemiBold"/>
                <TextBlock Text="外观、日志、一键初始化与关于信息。"
                           FontSize="12" Foreground="{DynamicResource TextSecondary}" Margin="0,4,0,0"/>
            </StackPanel>

            <hc:Card Style="{DynamicResource FluentCard}" Margin="0,12,0,0" Padding="14">
                <StackPanel>
                    <TextBlock Text="外观" FontWeight="SemiBold" FontSize="14" Margin="0,0,0,10"/>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="二次元装饰与提示文案" FontWeight="SemiBold"/>
                            <TextBlock Text="显示可爱的装饰元素与温柔提示。可随时一键关闭。" FontSize="12" Foreground="{DynamicResource TextSecondary}"/>
                        </StackPanel>
                        <ToggleButton Style="{DynamicResource FluentToggle}" Grid.Column="1" IsChecked="{Binding ShowAnime, Mode=TwoWay}" VerticalAlignment="Center"/>
                    </Grid>
                    <Separator Margin="0,12"/>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="显示底层注册表 / API 路径" FontWeight="SemiBold"/>
                            <TextBlock Text="在每个功能卡片下显示其对应的注册表键位，方便进阶用户核对。" FontSize="12" Foreground="{DynamicResource TextSecondary}"/>
                        </StackPanel>
                        <ToggleButton Style="{DynamicResource FluentToggle}" Grid.Column="1" IsChecked="{Binding ShowRegistryNote, Mode=TwoWay}" VerticalAlignment="Center"/>
                    </Grid>
                </StackPanel>
            </hc:Card>

            <hc:Card Style="{DynamicResource FluentCard}" Margin="0,12,0,0" Padding="14">
                <StackPanel>
                    <TextBlock Text="配置（预设分享）" FontWeight="SemiBold" FontSize="14" Margin="0,0,0,10"/>
                    <TextBlock Text="把当前功能的开启状态导出成预设文件，分享给朋友导入。不包含任何隐私数据。"
                               FontSize="12" Foreground="{DynamicResource TextSecondary}" Margin="0,0,0,10"/>
                    <StackPanel Orientation="Horizontal">
                        <Button Content="导出配置预设" Click="OnExportConfig" Style="{DynamicResource FluentButton}"/>
                        <Button Style="{DynamicResource FluentButtonSecondary}" Content="导入配置预设" Click="OnImportConfig" Margin="8,0,0,0"/>
                        <Button Style="{DynamicResource FluentButtonSecondary}" Content="打开日志目录" Click="OnOpenLogs" Margin="8,0,0,0"/>
                    </StackPanel>
                </StackPanel>
            </hc:Card>

            <hc:Card Style="{DynamicResource FluentCard}" Margin="0,12,0,0" Padding="14"
                     Background="#14C42B1C" BorderBrush="#33C42B1C" BorderThickness="1">
                <StackPanel>
                    <TextBlock Text="一键初始化全部内容" FontWeight="SemiBold" FontSize="14" Foreground="#FFC42B1C"/>
                    <TextBlock Text="将本工具恢复到首次使用的默认状态：还原全部功能设置到系统默认、复位外观选项、清空配置预设。"
                               TextWrapping="Wrap" FontSize="12" Foreground="{DynamicResource TextSecondary}"
                               Margin="0,4,0,10"/>
                    <Button Content="一键初始化全部内容" Click="OnResetAll"
                            Style="{DynamicResource FluentButtonDanger}" HorizontalAlignment="Left" Padding="14,0"/>
                </StackPanel>
            </hc:Card>

            <hc:Card Style="{DynamicResource FluentCard}" Margin="0,12,0,0" Padding="14">
                <StackPanel>
                    <TextBlock Text="关于" FontWeight="SemiBold" FontSize="14" Margin="0,0,0,10"/>
                    <TextBlock Text="Let's Meow! Toolbox" FontWeight="SemiBold" FontSize="15"/>
                    <TextBlock x:Name="TxtVersion" FontWeight="SemiBold" FontSize="13" Foreground="{DynamicResource TextPrimary}" Margin="0,2,0,0"/>
                    <TextBlock Text="Copyright (C) 2026 Github@Hatasoft-Studio"
                               FontSize="12.5" Foreground="{DynamicResource TextSecondary}" Margin="0,2,0,0"/>
                    <TextBlock Text="GPL-3.0 开源许可 · WPF · .NET 8 · HandyControl"
                               FontSize="12" Foreground="{DynamicResource TextSecondary}" Margin="0,2,0,0"/>
                    <Separator Margin="0,10"/>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="GitHub 仓库" FontWeight="SemiBold" VerticalAlignment="Center"/>
                        <TextBlock Text="{Binding RepoName}" FontSize="12.5" Foreground="{DynamicResource TextSecondary}"
                                   Margin="10,0,0,0" VerticalAlignment="Center"/>
                    </StackPanel>
                    <TextBlock Text="{Binding RepoUrl}" FontSize="12" Foreground="#FF3B5BDB"
                               Margin="0,2,0,0" TextTrimming="CharacterEllipsis"/>
                    <WrapPanel Margin="0,10,0,0">
                        <Button Content="前往 GitHub 仓库" Click="OnOpenRepo" Style="{DynamicResource FluentButton}"/>
                        <Button Content="查看更新日志" Click="OnViewChangelog" Style="{DynamicResource FluentButtonSecondary}" Margin="8,0,0,0"/>
                        <Button Content="查看开源许可协议（GPL-3.0）" Click="OnViewLicense" Style="{DynamicResource FluentButtonSecondary}" Margin="8,0,0,0"/>
                    </WrapPanel>
                    <TextBlock x:Name="TxtAbout" FontSize="12.5" Foreground="{DynamicResource TextSecondary}"
                               LineHeight="20" Margin="0,12,0,0"/>
                </StackPanel>
            </hc:Card>

        </StackPanel>
    </ScrollViewer>
</UserControl>
