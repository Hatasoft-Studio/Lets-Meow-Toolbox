<UserControl x:Class="LetsMeowToolbox.App.Views.HighRiskView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:hc="https://handyorg.github.io/handycontrol">
    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="4">
        <StackPanel>

            <StackPanel>
                <TextBlock Text="🔴 高危插件区（外置 DLL）" FontSize="16" FontWeight="SemiBold"/>
                <TextBlock Text="这里的高危功能以独立插件 DLL 提供，主程序本体不含任何高危代码。所有操作需管理员权限并二次确认。"
                           FontSize="12" Foreground="{DynamicResource TextSecondary}" Margin="0,4,0,0"/>
            </StackPanel>

            <!-- 未检测到插件时的引导 -->
            <hc:Card Style="{DynamicResource FluentCard}" x:Name="EmptyCard" Margin="0,16,0,0" Padding="16" Visibility="Collapsed">
                <StackPanel>
                    <TextBlock Text="未检测到高危插件" FontWeight="SemiBold" FontSize="15"/>
                    <TextBlock Text="请将高危插件 DLL 放入程序目录下的 plugins 文件夹后重新进入本区。"
                               TextWrapping="Wrap" FontSize="12" Foreground="{DynamicResource TextSecondary}" Margin="0,6,0,0"/>
                    <TextBlock x:Name="TxtPluginsDir" FontSize="11" Foreground="{DynamicResource TextDisabled}" Margin="0,4,0,0"/>
                </StackPanel>
            </hc:Card>

            <ItemsControl x:Name="PluginList" Margin="0,16,0,0">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <hc:Card Style="{DynamicResource FluentCard}" Margin="0,0,0,16" Padding="16">
                            <StackPanel>
                                <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="16"/>
                                <TextBlock Text="{Binding Description}" TextWrapping="Wrap" FontSize="12.5"
                                           Foreground="{DynamicResource TextSecondary}" Margin="0,6,0,0" LineHeight="19"/>

                                <ItemsControl ItemsSource="{Binding Actions}" Margin="0,12,0,0">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border BorderBrush="{DynamicResource BorderLine}" BorderThickness="1"
                                                    CornerRadius="8" Padding="12,10" Margin="0,0,0,10">
                                                <Grid>
                                                    <Grid.RowDefinitions>
                                                        <RowDefinition Height="Auto"/>
                                                        <RowDefinition Height="Auto"/>
                                                        <RowDefinition Height="Auto"/>
                                                    </Grid.RowDefinitions>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>

                                                    <StackPanel Orientation="Horizontal" Grid.Row="0" Grid.Column="0">
                                                        <TextBlock Text="🔴" FontSize="13" VerticalAlignment="Center"/>
                                                        <TextBlock Text="{Binding Title}" FontWeight="SemiBold" FontSize="14"
                                                                   Margin="8,0,0,0" VerticalAlignment="Center"/>
                                                    </StackPanel>
                                                    <TextBlock Grid.Row="0" Grid.Column="1"
                                                               Text="{Binding Applied, Converter={StaticResource AppliedConverter}}"
                                                               FontSize="11" VerticalAlignment="Center"/>

                                                    <TextBlock Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2"
                                                               Text="{Binding Description}" TextWrapping="Wrap" FontSize="12"
                                                               Foreground="{DynamicResource TextSecondary}" Margin="0,6,0,0" LineHeight="18"/>

                                                    <StackPanel Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="2"
                                                                Orientation="Horizontal" Margin="0,10,0,0">
                                                        <Button Content="启用（高危）" Click="OnApplyAction" Tag="{Binding}"
                                                                Style="{DynamicResource FluentButtonDanger}"/>
                                                        <Button Style="{DynamicResource FluentButtonSecondary}" Content="还原" Click="OnRestoreAction" Tag="{Binding}"
                                                                Margin="8,0,0,0"/>
                                                        <TextBlock Text="{Binding RegistryNote}" FontSize="10.5"
                                                                   Foreground="{DynamicResource TextDisabled}"
                                                                   VerticalAlignment="Center" Margin="12,0,0,0"
                                                                   TextTrimming="CharacterEllipsis" MaxWidth="320"/>
                                                    </StackPanel>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </hc:Card>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

        </StackPanel>
    </ScrollViewer>
</UserControl>
