<UserControl x:Class="LetsMeowToolbox.App.Views.UninstallerPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:hc="https://handyorg.github.io/handycontrol">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock Text="🧹 软件卸载" FontWeight="SemiBold" FontSize="15"/>
                <TextBlock Text="从卸载注册表读取已安装程序，调用原卸载程序，并扫描文件 / 注册表残留。所有删除都需你手动勾选确认。"
                           TextWrapping="Wrap" FontSize="12" Foreground="{DynamicResource TextSecondary}" Margin="0,4,0,0"/>
            </StackPanel>
            <StackPanel Orientation="Horizontal" Grid.Column="1" VerticalAlignment="Center">
                <Button Style="{DynamicResource FluentButtonSecondary}" Content="刷新列表" Click="OnRefresh" Margin="0,0,8,0"/>
                <Button Style="{DynamicResource FluentButtonSecondary}" Content="导出报告" Click="OnExportReport"/>
            </StackPanel>
        </Grid>

        <hc:Card Style="{DynamicResource FluentCard}" Grid.Row="1" Margin="0,12,0,8" Padding="0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <Border Padding="12,8" Background="{DynamicResource RegionBrush}">
                    <TextBlock Text="已安装程序（勾选后操作）" FontWeight="SemiBold" FontSize="13"/>
                </Border>
                <ItemsControl Grid.Row="1" ItemsSource="{Binding Programs}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Grid Margin="6,4">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <CheckBox Style="{DynamicResource FluentCheckBox}" IsChecked="{Binding IsChecked, Mode=TwoWay}" VerticalAlignment="Center"/>
                                <StackPanel Grid.Column="1" Margin="10,0">
                                    <TextBlock Text="{Binding DisplayName}" FontWeight="SemiBold"/>
                                    <TextBlock Text="{Binding Publisher}" FontSize="11"
                                               Foreground="{DynamicResource TextSecondary}"/>
                                    <TextBlock Text="{Binding Status}" FontSize="11"
                                               Foreground="#FF4CAF50" Visibility="{Binding HasStatus, Converter={StaticResource BoolToVisibilityConverter}}"/>
                                </StackPanel>
                                <TextBlock Grid.Column="2" Text="{Binding DisplayVersion}" FontSize="11"
                                           Foreground="{DynamicResource TextSecondary}" VerticalAlignment="Center" Margin="0,0,12,0"/>
                                <TextBlock Grid.Column="3" Text="{Binding SizeText}" FontSize="11"
                                           Foreground="{DynamicResource TextDisabled}" VerticalAlignment="Center"/>
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </Grid>
        </hc:Card>

        <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,0,0,8">
            <Button Style="{DynamicResource FluentButtonSecondary}" Content="卸载所选" Click="OnUninstallSelected" Width="110"/>
            <Button Style="{DynamicResource FluentButtonSecondary}" Content="扫描残留" Click="OnScanResidue" Width="100" Margin="8,0,0,0"/>
            <Button Style="{DynamicResource FluentButtonSecondary}" Content="清理残留（勾选确认）" Click="OnCleanResidue" Margin="8,0,0,0"/>
            <Button Style="{DynamicResource FluentButtonSecondary}" Content="解除占用" Click="OnUnlock" Margin="8,0,0,0"/>
            <TextBlock x:Name="TxtHint" Margin="12,0,0,0" VerticalAlignment="Center" FontSize="12"
                       Foreground="{DynamicResource TextSecondary}"/>
        </StackPanel>

        <hc:Card Style="{DynamicResource FluentCard}" Grid.Row="3" Margin="0,0,0,4" Padding="10" Visibility="{Binding HasResidue, Converter={StaticResource BoolToVisibilityConverter}}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <TextBlock Text="残留扫描结果（默认不勾选，确认无误后再清理）" FontWeight="SemiBold" FontSize="13"/>
                <ItemsControl Grid.Row="1" ItemsSource="{Binding Residues}" Margin="0,6,0,0">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Grid Margin="0,2">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="80"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <CheckBox Style="{DynamicResource FluentCheckBox}" IsChecked="{Binding IsChecked, Mode=TwoWay}" VerticalAlignment="Center"/>
                                <TextBlock Grid.Column="1" Text="{Binding Type}" FontSize="12"
                                           Foreground="{DynamicResource TextSecondary}" VerticalAlignment="Center"/>
                                <TextBlock Grid.Column="2" Text="{Binding Target}" FontSize="12"
                                           TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </Grid>
        </hc:Card>
    </Grid>
</UserControl>
