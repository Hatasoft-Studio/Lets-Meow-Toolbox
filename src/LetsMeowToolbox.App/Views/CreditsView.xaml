<UserControl x:Class="LetsMeowToolbox.App.Views.CreditsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:hc="https://handyorg.github.io/handycontrol">
    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="4">
        <StackPanel>

            <StackPanel>
                <TextBlock Text="💖 特别鸣谢" FontSize="16" FontWeight="SemiBold"/>
                <TextBlock Text="感谢以下开源项目与官方技术为本工具箱提供思路与基础。点击「访问」可打开该项目主页。"
                           FontSize="12.5" Foreground="{DynamicResource TextSecondary}" Margin="0,4,0,0"/>
            </StackPanel>

            <hc:Card Style="{DynamicResource FluentCard}" Margin="0,12,0,0" Padding="14">
                <StackPanel>
                    <TextBlock Text="本项目" FontWeight="SemiBold" FontSize="14" Margin="0,0,0,8"/>
                    <TextBlock FontSize="13" Foreground="{DynamicResource TextPrimary}" LineHeight="20"
                               Text="Let's Meow! Toolbox&#x0a;Copyright (C) 2026 Github@Hatasoft-Studio&#x0a;许可协议：GPL-3.0（GNU General Public License v3.0）"/>
                    <TextBlock Text="仓库：github.com/Hatasoft-Studio/Lets-Meow-Toolbox" FontSize="12.5"
                               Foreground="#FF3B5BDB" Margin="0,6,0,0"/>
                    <Button Content="访问 GitHub 仓库" Click="OnOpenRepo"
                            Style="{DynamicResource FluentButtonSecondary}" Margin="0,10,0,0"
                            HorizontalAlignment="Left" Padding="14,0"/>
                </StackPanel>
            </hc:Card>

            <TextBlock Text="集成的开源项目" FontWeight="SemiBold" FontSize="14" Margin="0,16,0,8"/>

            <!-- 项目模板：名称 + 许可 + 用途 + 仓库 + 访问按钮 -->
            <ItemsControl ItemsSource="{Binding Projects}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <hc:Card Style="{DynamicResource FluentCard}" Margin="0,0,0,10" Padding="12">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Row="0" Grid.Column="0" Orientation="Horizontal">
                                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="14"/>
                                    <TextBlock Text="{Binding License}" FontSize="11" Foreground="{DynamicResource TextDisabled}"
                                               VerticalAlignment="Center" Margin="10,0,0,0"/>
                                </StackPanel>
                                <Button Grid.Row="0" Grid.Column="1" Content="访问" Tag="{Binding Repo}"
                                        Click="OnVisit" Style="{DynamicResource FluentButtonSecondary}"
                                        Padding="12,4" MinWidth="64" VerticalAlignment="Center"/>

                                <TextBlock Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2"
                                           Text="{Binding Usage}" TextWrapping="Wrap" FontSize="12.5"
                                           Foreground="{DynamicResource TextSecondary}" Margin="0,6,0,0" LineHeight="19"/>

                                <TextBlock Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="2"
                                           Text="{Binding Repo}" FontSize="12.5" Foreground="#FF3B5BDB"
                                           Margin="0,6,0,0" TextTrimming="CharacterEllipsis"/>
                            </Grid>
                        </hc:Card>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <hc:Card Style="{DynamicResource FluentCard}" Margin="0,8,0,0" Padding="12">
                <StackPanel>
                    <TextBlock Text="官方底层支持" FontWeight="SemiBold" FontSize="14" Margin="0,0,0,6"/>
                    <TextBlock Text="Microsoft RestartManager / MoveFileEx / Registry API —— 解除占用与注册表操作的官方底层接口，本工具仅调用受支持的系统 API，不涉及驱动或未签名组件。"
                               FontSize="12.5" Foreground="{DynamicResource TextSecondary}" LineHeight="19" TextWrapping="Wrap"/>
                </StackPanel>
            </hc:Card>

        </StackPanel>
    </ScrollViewer>
</UserControl>
