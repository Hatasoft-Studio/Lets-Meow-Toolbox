<Window x:Class="LetsMeowToolbox.App.Views.LanguageManagerDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="语言管理" Width="680" Height="580" MinWidth="620" MinHeight="480"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        Background="{DynamicResource SurfaceBrush}" Foreground="{DynamicResource TextPrimary}"
        FontFamily="Segoe UI Variable Text, Microsoft YaHei UI, Segoe UI" FontSize="14"
        UseLayoutRounding="True">
    <Window.Resources>
        <!-- 列表项：显式前景色 + 自绘选中/悬停高亮（不受外部主题影响） -->
        <Style x:Key="PackItemStyle" TargetType="ListBoxItem">
            <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="ItemBg" Margin="2,1" CornerRadius="6" Background="Transparent"
                                BorderThickness="1" BorderBrush="Transparent" SnapsToDevicePixels="True">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ItemBg" Property="Background" Value="#18E8519C"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="ItemBg" Property="Background" Value="#33E8519C"/>
                                <Setter TargetName="ItemBg" Property="BorderBrush" Value="#E8519C"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.6"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="语言管理" FontSize="18" FontWeight="SemiBold"/>
        <TextBlock x:Name="TxtLanguageDir" Grid.Row="1" FontSize="12" TextWrapping="Wrap"
                   Foreground="{DynamicResource TextSecondary}" Margin="0,6,0,10"/>

        <ListBox x:Name="PackList" Grid.Row="2" SelectionChanged="OnSelectionChanged"
                 ItemContainerStyle="{StaticResource PackItemStyle}"
                 BorderBrush="{DynamicResource BorderLine}" BorderThickness="1"
                 Background="{DynamicResource SurfaceBrush}"
                 HorizontalContentAlignment="Stretch">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <Border Padding="10,8" BorderThickness="0,0,0,1" BorderBrush="{DynamicResource BorderLine}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="{Binding DisplayName}" FontWeight="SemiBold" FontSize="14"
                                               Foreground="{DynamicResource TextPrimary}" VerticalAlignment="Center"/>
                                    <Border Background="#E8F5E9" CornerRadius="4" Padding="6,1" Margin="8,0,0,0"
                                            Visibility="{Binding IsOfficial, Converter={StaticResource BoolToVisibilityConverter}}">
                                        <TextBlock Text="官方" FontSize="11" Foreground="#2E7D32"/>
                                    </Border>
                                    <Border Background="#F1F3F4" CornerRadius="4" Padding="6,1" Margin="6,0,0,0"
                                            Visibility="{Binding BuiltIn, Converter={StaticResource BoolToVisibilityConverter}}">
                                        <TextBlock Text="内嵌" FontSize="11" Foreground="#5F6368"/>
                                    </Border>
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                                    <Viewbox Width="13" Height="15" Margin="0,0,5,0"
                                             Visibility="{Binding IsOfficial, Converter={StaticResource BoolToVisibilityConverter}}">
                                        <Canvas Width="24" Height="28">
                                            <Path Data="M12,1 L22.5,5.2 L22.5,13.5 C22.5,19.8 17.6,24.6 12,27 C6.4,24.6 1.5,19.8 1.5,13.5 L1.5,5.2 Z"
                                                  Fill="#2E9E4F"/>
                                            <Path Data="M6.8,14.2 L10.6,18 L17.6,10.6" Stroke="#FFFFFF" StrokeThickness="2.6"
                                                  StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"/>
                                        </Canvas>
                                    </Viewbox>
                                    <TextBlock Text="{Binding Author}" FontSize="12" Foreground="{DynamicResource TextSecondary}"/>
                                    <TextBlock Text="  ·  " FontSize="12" Foreground="{DynamicResource TextSecondary}"/>
                                    <TextBlock Text="{Binding Id}" FontSize="12" Foreground="{DynamicResource TextSecondary}"/>
                                    <TextBlock Text="  ·  v" FontSize="12" Foreground="{DynamicResource TextSecondary}"/>
                                    <TextBlock Text="{Binding Version}" FontSize="12" Foreground="{DynamicResource TextSecondary}"/>
                                </StackPanel>
                            </StackPanel>
                            <TextBlock Grid.Column="1" Text="{Binding TypeText}" FontSize="12"
                                       Foreground="{DynamicResource TextSecondary}" VerticalAlignment="Center"/>
                        </Grid>
                    </Border>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>

        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
            <Button x:Name="BtnInstall" Content="安装语言包…" Click="OnInstall"
                    Style="{DynamicResource FluentButtonSecondary}"/>
            <Button x:Name="BtnLoad" Content="加载所选语言" Click="OnLoad"
                    Style="{DynamicResource FluentButtonPink}" Background="#E8519C" Foreground="#FFFFFF"
                    Margin="8,0,0,0"/>
            <Button x:Name="BtnClose" Content="关闭" Click="OnClose"
                    Style="{DynamicResource FluentButtonSecondary}" Margin="8,0,0,0"/>
        </StackPanel>
    </Grid>
</Window>
