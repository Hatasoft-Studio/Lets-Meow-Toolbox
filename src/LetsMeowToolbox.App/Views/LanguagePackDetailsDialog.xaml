<Window x:Class="LetsMeowToolbox.App.Views.LanguagePackDetailsDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="语言包信息" Width="540" SizeToContent="Height" MaxHeight="720"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False" ResizeMode="NoResize"
        Background="{DynamicResource SurfaceBrush}" Foreground="{DynamicResource TextPrimary}"
        FontFamily="Segoe UI Variable Text, Microsoft YaHei UI, Segoe UI" FontSize="14"
        UseLayoutRounding="True">
    <Grid Margin="22,18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Orientation="Horizontal">
            <TextBlock x:Name="TxtPackName" FontSize="18" FontWeight="SemiBold" TextWrapping="Wrap"/>
        </StackPanel>

        <Grid Grid.Row="1" Margin="0,12,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="96"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <TextBlock Text="制作者" FontSize="12" VerticalAlignment="Top"
                       Foreground="{DynamicResource TextSecondary}"/>
            <StackPanel Grid.Column="1" Orientation="Horizontal">
                <Viewbox Width="14" Height="16" Margin="0,1,6,0"
                         Visibility="{Binding IsOfficial, Converter={StaticResource BoolToVisibilityConverter}}">
                    <Canvas Width="24" Height="28">
                        <Path Data="M12,1 L22.5,5.2 L22.5,13.5 C22.5,19.8 17.6,24.6 12,27 C6.4,24.6 1.5,19.8 1.5,13.5 L1.5,5.2 Z"
                              Fill="#2E9E4F"/>
                        <Path Data="M6.8,14.2 L10.6,18 L17.6,10.6" Stroke="#FFFFFF" StrokeThickness="2.6"
                              StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"/>
                    </Canvas>
                </Viewbox>
                <TextBlock x:Name="TxtAuthor" FontSize="13" TextWrapping="Wrap" VerticalAlignment="Center"/>
                <Border x:Name="TagOfficial" Background="#E8F5E9" CornerRadius="4" Padding="6,1" Margin="8,0,0,0"
                        VerticalAlignment="Center">
                    <TextBlock x:Name="TxtOfficialTag" FontSize="11" Foreground="#2E7D32"/>
                </Border>
            </StackPanel>
        </Grid>

        <ScrollViewer Grid.Row="2" MaxHeight="420" VerticalScrollBarVisibility="Auto" Margin="0,8,0,0">
            <StackPanel x:Name="ExtraDetailsPanel"/>
        </ScrollViewer>

        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,18,0,0">
            <Button x:Name="BtnCancel" Content="取消" Click="OnCancel"
                    Style="{DynamicResource FluentButtonSecondary}" MinWidth="92"/>
            <Button x:Name="BtnAction" Content="安装" Click="OnAction"
                    Style="{DynamicResource FluentButtonPink}" Background="#E8519C" Foreground="#FFFFFF"
                    MinWidth="92" Margin="10,0,0,0"/>
        </StackPanel>
    </Grid>
</Window>
