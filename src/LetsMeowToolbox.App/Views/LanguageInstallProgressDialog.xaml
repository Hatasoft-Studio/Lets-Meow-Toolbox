<Window x:Class="LetsMeowToolbox.App.Views.LanguageInstallProgressDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="安装语言包" Width="440" SizeToContent="Height"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False" ResizeMode="NoResize"
        Background="{DynamicResource SurfaceBrush}" Foreground="{DynamicResource TextPrimary}"
        FontFamily="Segoe UI Variable Text, Microsoft YaHei UI, Segoe UI" FontSize="14"
        UseLayoutRounding="True">
    <StackPanel Margin="24,20">
        <TextBlock x:Name="TxtTitle" Text="正在安装语言包" FontSize="16" FontWeight="SemiBold"/>
        <TextBlock x:Name="TxtStatus" Margin="0,14,0,8" FontSize="12"
                   Foreground="{DynamicResource TextSecondary}"/>
        <ProgressBar x:Name="Bar" Height="8" Minimum="0" Maximum="100" Value="0"
                     Foreground="#E8519C" BorderThickness="0"/>
        <TextBlock x:Name="TxtPercent" Margin="0,6,0,0" FontSize="12" HorizontalAlignment="Right"
                   Foreground="{DynamicResource TextSecondary}">0%</TextBlock>
    </StackPanel>
</Window>
