<UserControl x:Class="LetsMeowToolbox.App.Views.UwpPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:hc="https://handyorg.github.io/handycontrol">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock Text="🧩 预装应用卸载（仅白名单可删）" FontWeight="SemiBold" FontSize="15"/>
                <TextBlock Text="只允许卸载白名单内的预装应用；系统核心 UWP（商店、计算器、照片等）一律禁止，避免破坏系统。"
                           TextWrapping="Wrap" FontSize="12" Foreground="{DynamicResource TextSecondary}" Margin="0,4,0,0"/>
            </StackPanel>
            <Button Style="{DynamicResource FluentButtonSecondary}" Grid.Column="1" Content="刷新列表" Click="OnRefresh" VerticalAlignment="Center"/>
        </Grid>

        <TextBlock Grid.Row="1" x:Name="TxtHint" Margin="0,8,0,4" FontSize="12"
                   Foreground="{DynamicResource TextSecondary}"/>

        <hc:Card Style="{DynamicResource FluentCard}" Grid.Row="2" Padding="8">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <ItemsControl ItemsSource="{Binding Apps}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Grid Margin="4,2">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <CheckBox Style="{DynamicResource FluentCheckBox}" IsChecked="{Binding IsChecked, Mode=TwoWay}" IsEnabled="{Binding Removable}"
                                          VerticalAlignment="Center"/>
                                <StackPanel Grid.Column="1" Margin="10,0">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="{Binding DisplayName}" FontWeight="SemiBold"/>
                                        <TextBlock Text="{Binding Version, StringFormat='{}  v{0}'}" FontSize="11"
                                                   Foreground="{DynamicResource TextDisabled}" VerticalAlignment="Center"/>
                                        <Border Margin="8,0,0,0" CornerRadius="4" Padding="6,1"
                                                Background="{Binding CoreProtected, Converter={StaticResource CoreBadgeConverter}}">
                                            <TextBlock Text="{Binding Badge}" FontSize="10" Foreground="White"/>
                                        </Border>
                                    </StackPanel>
                                    <TextBlock Text="{Binding PackageFullName}" FontSize="11"
                                               Foreground="{DynamicResource TextSecondary}" TextTrimming="CharacterEllipsis"/>
                                    <TextBlock Text="{Binding Status}" FontSize="11" Foreground="#FF4CAF50"
                                               Visibility="{Binding HasStatus, Converter={StaticResource BoolToVisibilityConverter}}"/>
                                </StackPanel>
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <Button Style="{DynamicResource FluentButtonSecondary}" Grid.Row="1" Content="卸载所选（仅白名单）" Click="OnUninstallSelected"
                        HorizontalAlignment="Right" Margin="0,6,4,0" Height="34"/>
            </Grid>
        </hc:Card>
    </Grid>
</UserControl>
