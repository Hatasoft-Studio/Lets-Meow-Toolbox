<Window x:Class="LetsMeowToolbox.App.Views.LicenseDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="许可协议" Width="720" Height="580"
        WindowStartupLocation="CenterScreen" ResizeMode="CanResize"
        MinWidth="520" MinHeight="420"
        Background="{DynamicResource SurfaceBrush}"
        FontFamily="Segoe UI Variable Text, Microsoft YaHei UI, Microsoft YaHei, Segoe UI, sans-serif"
        UseLayoutRounding="True" TextOptions.TextFormattingMode="Ideal">
    <Border Margin="14" CornerRadius="8" Background="{DynamicResource SurfaceBrush}"
            BorderBrush="{DynamicResource CardBorder}" BorderThickness="1">
        <Grid Margin="24,22,24,20">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <StackPanel Orientation="Horizontal" Grid.Row="0">
                <TextBlock Text="📜" FontSize="24" VerticalAlignment="Center"/>
                <TextBlock x:Name="TxtTitle" Text="请阅读并同意协议后使用" FontSize="18" FontWeight="SemiBold"
                           Foreground="{DynamicResource TextPrimary}" Margin="12,0,0,0" VerticalAlignment="Center"/>
            </StackPanel>

            <TextBlock Grid.Row="1" Margin="0,12,0,10" FontSize="13"
                       Foreground="{DynamicResource TextSecondary}" TextWrapping="Wrap"
                       Text="欢迎使用 Let's Meow! Toolbox。本软件依据 GNU General Public License v3.0（GPL-3.0）开源。请阅读以下协议全文，点击「我同意」后才可以继续使用；若不同意，软件将退出。"/>

            <Border Grid.Row="2" BorderBrush="{DynamicResource CardBorder}" BorderThickness="1"
                    CornerRadius="6" Background="White" ClipToBounds="True">
                <TextBox x:Name="TxtLicense" IsReadOnly="True" AcceptsReturn="True"
                         BorderThickness="0" Background="White" Foreground="#1A1A1A"
                         FontFamily="Consolas, Cascadia Mono, Courier New" FontSize="11.5"
                         VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"
                         TextWrapping="NoWrap" Padding="12" TextOptions.TextFormattingMode="Ideal"/>
            </Border>

            <TextBlock Grid.Row="3" x:Name="TxtHint" Margin="0,10,0,0" FontSize="12"
                       Foreground="{DynamicResource TextSecondary}" TextWrapping="Wrap"
                       Text="点击「我同意」即表示你接受 GNU General Public License v3.0 的全部条款。"/>

            <Grid Grid.Row="4" Margin="0,16,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" VerticalAlignment="Center" FontSize="11.5"
                           Foreground="{DynamicResource TextTertiary}"
                           Text="Let's Meow! Toolbox · GPL-3.0"/>
                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <Button x:Name="BtnDecline" Content="不同意" Click="OnDecline"
                            Style="{DynamicResource FluentButtonSecondary}" MinWidth="96"/>
                    <Button x:Name="BtnAgree" Content="我同意" Click="OnAgree"
                            Style="{DynamicResource FluentButton}" MinWidth="96" Margin="10,0,0,0"/>
                    <Button x:Name="BtnClose" Content="关闭" Click="OnClose"
                            Style="{DynamicResource FluentButton}" MinWidth="96"
                            Visibility="Collapsed"/>
                </StackPanel>
            </Grid>
        </Grid>
    </Border>
</Window>
