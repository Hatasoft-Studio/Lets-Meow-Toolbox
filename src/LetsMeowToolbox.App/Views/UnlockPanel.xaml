<UserControl x:Class="LetsMeowToolbox.App.Views.UnlockPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:hc="https://handyorg.github.io/handycontrol">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0">
            <TextBlock Text="解除占用（查找占用进程 / 关闭程序释放占用 / 开机延迟删除）"
                       FontWeight="SemiBold" FontSize="15"/>
            <TextBlock Margin="0,4,0,0"
                       Text="删除文件提示“正在使用”时，用它找出占用它的程序。系统核心进程会被保护，无法被结束。"
                       TextWrapping="Wrap" FontSize="12" Foreground="{DynamicResource TextSecondary}"/>
        </StackPanel>

        <Grid Grid.Row="1" Margin="0,12,0,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <hc:TextBox Style="{DynamicResource FluentTextBox}" x:Name="TxtPath" hc:InfoElement.Placeholder="输入文件 / 文件夹路径…"
                        VerticalContentAlignment="Center" Height="32"/>
            <Button Style="{DynamicResource FluentButtonSecondary}" Grid.Column="1" Content="浏览…" Click="OnBrowse" Margin="8,0,0,0" Width="72"/>
            <Button Style="{DynamicResource FluentButtonSecondary}" Grid.Column="2" Content="查找占用进程" Click="OnFind" Margin="8,0,0,0" Width="120"/>
        </Grid>

        <Grid Grid.Row="2" Margin="0,0,0,8">
            <StackPanel Orientation="Horizontal">
                <CheckBox Style="{DynamicResource FluentCheckBox}" x:Name="ChkDeep" Content="深度扫描（尝试独占打开确认占用）" VerticalAlignment="Center"/>
                <TextBlock x:Name="TxtHint" Margin="16,0,0,0" VerticalAlignment="Center" FontSize="12"
                           Foreground="{DynamicResource TextSecondary}"/>
            </StackPanel>
        </Grid>

        <hc:Card Style="{DynamicResource FluentCard}" Grid.Row="3" Padding="8" Margin="0,0,0,8"
                 MinHeight="120">
            <ItemsControl ItemsSource="{Binding Occupiers}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Grid Margin="4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="{Binding AppName}" FontWeight="SemiBold"/>
                                <TextBlock FontSize="11" Foreground="{DynamicResource TextSecondary}">
                                    <Run Text="进程 "/><Run Text="{Binding ProcessName}"/><Run Text=" · PID "/><Run Text="{Binding ProcessId}"/>
                                </TextBlock>
                                <TextBlock Text="{Binding Status}" FontSize="11" Foreground="#FF4CAF50"
                                           Visibility="{Binding HasStatus, Converter={StaticResource BoolToVisibilityConverter}}"/>
                            </StackPanel>
                            <TextBlock Grid.Column="1" Text="{Binding ProcessId}" FontSize="12"
                                       Foreground="{DynamicResource TextDisabled}" VerticalAlignment="Center" Margin="0,0,12,0"/>
                            <Button Style="{DynamicResource FluentButtonSecondary}" Grid.Column="2" Content="结束进程" Click="OnEndProcess"
                                    Tag="{Binding}" VerticalAlignment="Center"/>
                        </Grid>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </hc:Card>

        <StackPanel Grid.Row="4" Orientation="Horizontal">
            <Button Style="{DynamicResource FluentButtonSecondary}" Content="安排重启删除（选定路径）" Click="OnScheduleRebootDelete" Margin="0,0,8,0"/>
            <Button Style="{DynamicResource FluentButtonSecondary}" Content="查看待重启删除列表" Click="OnShowPending"/>
        </StackPanel>
    </Grid>
</UserControl>
