<Window x:Class="LetsMeowToolbox.App.Views.UpdateDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="发现新版本" Width="560" SizeToContent="Height" MaxHeight="720"
        ResizeMode="NoResize" WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        Background="{DynamicResource SurfaceBrush}" Foreground="{DynamicResource TextPrimary}"
        FontFamily="Segoe UI Variable Text, Microsoft YaHei UI, Segoe UI" FontSize="14"
        UseLayoutRounding="True">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Orientation="Horizontal">
            <TextBlock x:Name="TxtIcon" Text="🚀" FontSize="26" Margin="0,0,12,0" VerticalAlignment="Top"
                       FontFamily="Segoe UI Emoji, Segoe UI"/>
            <StackPanel>
                <TextBlock x:Name="TxtTitle" FontSize="18" FontWeight="SemiBold"/>
                <TextBlock x:Name="TxtSubtitle" FontSize="12.5" Foreground="{DynamicResource TextSecondary}"
                           Margin="0,4,0,0" TextWrapping="Wrap"/>
            </StackPanel>
        </StackPanel>

        <Border Grid.Row="1" Margin="0,16,0,0" Padding="14,10" CornerRadius="8"
                Background="{DynamicResource SurfaceBrush}" BorderThickness="1"
                BorderBrush="{DynamicResource BorderLine}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Text="当前版本" FontSize="12.5" Foreground="{DynamicResource TextSecondary}"/>
                <TextBlock x:Name="TxtCurrent" Grid.Row="0" Grid.Column="1" FontSize="12.5"
                           FontWeight="SemiBold" Margin="16,0,0,0"/>

                <TextBlock Grid.Row="1" Text="最新版本" FontSize="12.5" Foreground="{DynamicResource TextSecondary}"
                           Margin="0,6,0,0"/>
                <TextBlock x:Name="TxtLatest" Grid.Row="1" Grid.Column="1" FontSize="12.5"
                           FontWeight="SemiBold" Foreground="#FFE8519C" Margin="16,6,0,0"/>

                <TextBlock Grid.Row="2" Text="官方下载地址" FontSize="12.5" Foreground="{DynamicResource TextSecondary}"
                           Margin="0,6,0,0"/>
                <TextBlock x:Name="TxtUrl" Grid.Row="2" Grid.Column="1" FontSize="12.5" Foreground="#FF3B5BDB"
                           TextTrimming="CharacterEllipsis" Margin="16,6,0,0"/>
            </Grid>
        </Border>

        <StackPanel Grid.Row="2" Margin="0,14,0,0">
            <TextBlock Text="更新内容" FontSize="13" FontWeight="SemiBold" Margin="0,0,0,6"/>
            <Border CornerRadius="6" BorderThickness="1" BorderBrush="{DynamicResource BorderLine}"
                    Background="{DynamicResource SurfaceBrush}">
                <ScrollViewer VerticalScrollBarVisibility="Auto" MaxHeight="200">
                    <TextBlock x:Name="TxtChangelog" FontSize="12.5" LineHeight="20"
                               Foreground="{DynamicResource TextSecondary}" TextWrapping="Wrap" Margin="12,10"/>
                </ScrollViewer>
            </Border>
        </StackPanel>

        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,18,0,0">
            <Button x:Name="BtnLater" Content="稍后再说" Click="OnLater"
                    Style="{DynamicResource FluentButtonSecondary}" MinWidth="110"/>
            <Button x:Name="BtnGo" Content="前往官网获取新版本" Click="OnGo"
                    Style="{DynamicResource FluentButtonPink}" Background="#E8519C" Foreground="#FFFFFF"
                    MinWidth="150" Margin="10,0,0,0"/>
        </StackPanel>
    </Grid>
</Window>
